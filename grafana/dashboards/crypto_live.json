{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "PostgreSQL / Spark Thrift Server pointing at Gold and alerts tables",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Anomaly markers",
        "rawQuery": true,
        "rawSql": "SELECT window_end AS time, symbol || ': anomaly (cluster=' || cluster || ', dist=' || ROUND(CAST(distance_to_centroid AS NUMERIC),4) || ')' AS text FROM gold_alerts WHERE $__timeFilter(window_end) ORDER BY time",
        "showIn": 0,
        "step": 60,
        "tags": ["anomaly"],
        "type": "tags"
      }
    ]
  },
  "description": "Real-Time Crypto Market Analysis — live prices, moving averages, volatility, and anomaly alerts",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Live Prices",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Real-time close price for all tracked symbols",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "time_series",
          "rawSql": "SELECT window_end AS time, symbol AS metric, close AS value FROM gold_indicators WHERE $__timeFilter(window_end) ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Live Close Price — BTC / ETH / BNB / SOL",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "Moving Averages",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "5-minute SMA and EMA overlaid on close price",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SMA" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" } }]
          },
          {
            "matcher": { "id": "byName", "options": "EMA" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 11 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "time_series",
          "rawSql": "SELECT window_end AS time, 'Close (' || symbol || ')' AS metric, close AS value FROM gold_indicators WHERE symbol = '${symbol}' AND $__timeFilter(window_end) UNION ALL SELECT window_end, 'SMA (' || symbol || ')', sma FROM gold_indicators WHERE symbol = '${symbol}' AND $__timeFilter(window_end) UNION ALL SELECT window_end, 'EMA (' || symbol || ')', ema FROM gold_indicators WHERE symbol = '${symbol}' AND $__timeFilter(window_end) ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Price + SMA + EMA — ${ symbol }",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Volatility",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Current volatility (coefficient of variation) per symbol",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.03 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 0.05
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "table",
          "rawSql": "SELECT symbol, volatility FROM gold_indicators WHERE window_end = (SELECT MAX(window_end) FROM gold_indicators)",
          "refId": "A"
        }
      ],
      "title": "Volatility Gauge (latest window)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Volatility over time per symbol",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "time_series",
          "rawSql": "SELECT window_end AS time, symbol AS metric, volatility AS value FROM gold_indicators WHERE $__timeFilter(window_end) ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Volatility Over Time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 103,
      "title": "Anomalies",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Number of anomalies detected per symbol in the last 24 hours",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 29 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "table",
          "rawSql": "SELECT symbol, COUNT(*) AS anomaly_count FROM gold_alerts WHERE window_end >= NOW() - INTERVAL '24 hours' GROUP BY symbol ORDER BY anomaly_count DESC",
          "refId": "A"
        }
      ],
      "title": "Anomaly Count — Last 24 h",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Recent anomaly events with cluster and distance details",
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "is_anomaly" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 29 },
      "id": 6,
      "options": { "sortBy": [{ "displayName": "window_end", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "format": "table",
          "rawSql": "SELECT window_end, symbol, cluster, ROUND(CAST(distance_to_centroid AS NUMERIC), 4) AS distance_to_centroid, is_anomaly FROM gold_alerts WHERE $__timeFilter(window_end) ORDER BY window_end DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Anomaly Events",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["crypto", "real-time", "streaming"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "BTCUSDT", "value": "BTCUSDT" },
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "definition": "SELECT DISTINCT symbol FROM gold_indicators ORDER BY symbol",
        "hide": 0,
        "includeAll": false,
        "label": "Symbol",
        "multi": false,
        "name": "symbol",
        "options": [],
        "query": "SELECT DISTINCT symbol FROM gold_indicators ORDER BY symbol",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Crypto Live Dashboard",
  "uid": "crypto-live-v1",
  "version": 1
}
